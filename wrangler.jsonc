{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stag-hunt-simulation-colorado-river-edition",
  "compatibility_date": "2026-05-21",
  "observability": {
    "enabled": true
  },
  // Serve the built app, not raw source. Workers Builds settings:
  //   Build command:  cd kyles-card-game && npm install && npm run build
  //   Deploy command: npx wrangler deploy
  "assets": {
    "directory": "kyles-card-game/dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
